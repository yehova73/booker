generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookDimension {
  letter
  paperback
  square
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String?               @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  accountClaimed        Boolean               @default(false)
  userQuickStartActions Json?
  accounts              Account[]
  sessions              Session[]
  changeEmailTokens     ChangeEmailToken[]
  changePasswordTokens  ChangePasswordToken[]
  collections           Collection[]
  files                 File[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChangeEmailToken {
  id            String    @id @default(cuid())
  newEmail      String
  userId        String
  createdAt     DateTime  @default(now())
  invalidatedAt DateTime?
  changedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChangePasswordToken {
  id            String    @id @default(cuid())
  userId        String
  createdAt     DateTime  @default(now())
  invalidatedAt DateTime?
  changedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Collection {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(100)
  color       String   @default("#dbeafe") @db.VarChar(7)
  description String   @default("") @db.Text
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books       Book[]

  @@index([userId, createdAt])
}

model Book {
  id           String        @id @default(cuid())
  title        String        @db.VarChar(100)
  description  String        @default("") @db.Text
  dimension    BookDimension @default(paperback)
  bookData     Json?
  coverId      String?       @unique
  coverPageId  String?
  collectionId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  cover        File?         @relation("BookCover", fields: [coverId], references: [id], onDelete: SetNull)
  files        File[]

  @@index([collectionId, createdAt])
}

model File {
  id           String   @id @default(cuid())
  userId       String
  storageKey   String   @unique
  originalName String   @db.VarChar(255)
  contentType  String   @db.VarChar(100)
  size         Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books        Book[]
  coverForBook Book?    @relation("BookCover")

  @@index([userId, createdAt])
}
