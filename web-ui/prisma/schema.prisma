generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookDimension {
  letter
  paperback
  square
}

enum AiBookPageSize {
  letter
  paperback
  square
}

enum AiBookPuzzleType {
  sudoku
  wordSearch
  maze
  crossword
  wordScramble
  logicPuzzle
  coloringPage
}

enum AiBookPlanPageType {
  titlePage
  storyScene
  activity
  sudoku
  wordSearch
  maze
  crossword
  wordScramble
  logicPuzzle
  coloringPage
}

enum AiBookPlanStatus {
  draft
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String?               @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  accountClaimed        Boolean               @default(false)
  userQuickStartActions Json?
  accounts              Account[]
  sessions              Session[]
  changeEmailTokens     ChangeEmailToken[]
  changePasswordTokens  ChangePasswordToken[]
  collections           Collection[]
  files                 File[]
  aiBookPlans           AiBookPlan[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChangeEmailToken {
  id            String    @id @default(cuid())
  newEmail      String
  userId        String
  createdAt     DateTime  @default(now())
  invalidatedAt DateTime?
  changedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChangePasswordToken {
  id            String    @id @default(cuid())
  userId        String
  createdAt     DateTime  @default(now())
  invalidatedAt DateTime?
  changedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Collection {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(100)
  color       String   @default("#dbeafe") @db.VarChar(7)
  description String   @default("") @db.Text
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books       Book[]

  @@index([userId, createdAt])
}

model Book {
  id           String        @id @default(cuid())
  title        String        @db.VarChar(100)
  description  String        @default("") @db.Text
  dimension    BookDimension @default(paperback)
  bookData     Json?
  coverId      String?       @unique
  coverPageId  String?
  collectionId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  cover        File?         @relation("BookCover", fields: [coverId], references: [id], onDelete: SetNull)
  files        File[]
  kdpExports   BookKdpExport[]

  @@index([collectionId, createdAt])
}

model AiBookPlan {
  id             String             @id @default(cuid())
  title          String             @db.VarChar(100)
  niche          String             @default("") @db.VarChar(100)
  pageCount      Int                @default(32)
  pageSize       AiBookPageSize     @default(letter)
  initialPrompt  String             @db.Text
  storyPuzzle    Boolean            @default(false)
  status         AiBookPlanStatus   @default(draft)
  userId         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzles        AiBookPlanPuzzle[]
  pages          AiBookPlanPage[]

  @@index([userId, createdAt])
}

model AiBookPlanPuzzle {
  id        String          @id @default(cuid())
  planId    String
  type      AiBookPuzzleType
  createdAt DateTime        @default(now())
  plan      AiBookPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, type])
  @@index([planId])
}

model AiBookPlanPage {
  id                 String              @id @default(cuid())
  planId             String
  pageNumber         Int
  type               AiBookPlanPageType
  prompt             String              @db.Text
  settings           Json?
  regenerationCount  Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  plan               AiBookPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, pageNumber])
  @@index([planId, pageNumber])
}

model File {
  id           String   @id @default(cuid())
  userId       String
  storageKey   String   @unique
  originalName String   @db.VarChar(255)
  contentType  String   @db.VarChar(100)
  size         Int
  bookCover    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books        Book[]
  coverForBook Book?    @relation("BookCover")
  kdpExport    BookKdpExport?

  @@index([userId, createdAt])
}

model BookKdpExport {
  id           String       @id @default(cuid())
  bookId       String
  fileId       String       @unique
  trimPreset   BookDimension
  bleedEnabled Boolean      @default(false)
  createdAt    DateTime     @default(now())
  book         Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([bookId, createdAt])
}
